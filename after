rebuilt_servers = []

for ch in chunks:
    if not ch.strip().startswith('server'):
        continue

    m_name = re.search(r'server_name\s+([^;]+);', ch)
    domain = m_name.group(1).strip().split()[0] if m_name else "_"

    if domain in ['_', 'localhost', '""', "''"]:
        rebuilt_servers.append(ch.strip())
        continue

    header_lines = []
    for line in ch.splitlines():
        s = line.strip()
        # ИСПРАВЛЕНИЕ: Добавлен 'http2 ' в список разрешенных директив
        if any(s.startswith(k) for k in ['listen ', 'server_name ', 'server_tokens ', 'ssl_', 'http2 ']) and s.endswith(';'):
            header_lines.append("    " + s)

    # ИСПРАВЛЕНИЕ: Защитная проверка. Если http2 потерялся, но мы знаем, что он нужен, добавляем принудительно
    if not any('http2' in l for l in header_lines):
        # Если Nginx >= 1.25.1 (в оригинальном скрипте определялось, мы просто добавим новую директиву, 
        # если у вас старая версия, она будет проигнорирована или выдаст ошибку. 
        # Но раз мы добавили 'http2 ' в startswith, если он был в listen, он сохранится.
        # Эта строчка — страховка для новых версий Nginx.
        header_lines.append("    http2 on;")

    custom_locations = []
    for m_loc in re.finditer(r'location\s+\^~\s+/(?!api/|ollama/)([A-Za-z0-9_-]+)/\s*\{([^}]*)\}', ch):
        custom_locations.append(f"    location ^~ /{m_loc.group(1)}/ {{{m_loc.group(2)}}}")

    srv = ["server {"] + header_lines + custom_locations

    if domain == main_domain:
        srv.append("""    location ^~ /api/ {
        proxy_pass http://127.0.0.1:3080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
    }
    location ^~ /ollama/ {
        proxy_pass http://127.0.0.1:3080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
    location / {
        root /var/www/open-webui;
        index index.html;
        try_files $uri $uri/ /index.html;
    }""")
        print(f"   ✅ Основной домен [{domain}] -> подключен Open WebUI")
    else:
        sub_prefix = re.sub(r'[^a-zA-Z0-9_-]', '_', domain.split('.')[0].lower())
        target_dir = f"/var/www/webui_{sub_prefix}"
        os.makedirs(target_dir, exist_ok=True)
        with open(os.path.join(target_dir, "index.html"), "w", encoding="utf-8") as wf:
            wf.write(build_subdomain_html(domain))
        srv.append(f"""    location ^~ /api/sub/ {{
