#!/bin/bash
set -e

echo "=================================================================="
echo " 🚀 Установка интерактивного комплекса WebUI (~15 МБ RAM)"
echo "=================================================================="

apt-get update -y -qq && apt-get install -y -qq python3 curl openssl

# 1. Извлечение оригинального интерфейса Open WebUI (если еще не установлен)
if [ ! -f /var/www/open-webui/index.html ]; then
    echo "📦 Извлечение оригинального интерфейса Open WebUI..."
    apt-get install -y -qq docker.io
    systemctl start docker
    docker rm -f temp-webui 2>/dev/null || true
    docker create --name temp-webui ghcr.io/open-webui/open-webui:main
    rm -rf /var/www/open-webui
    docker cp temp-webui:/app/build /var/www/open-webui
    docker rm -f temp-webui
    docker system prune -a --volumes -f >/dev/null 2>&1 || true
    systemctl stop docker docker.socket && systemctl disable docker docker.socket
fi

# 2. Автоматическое определение основного домена из конфига Nginx
MAIN_DOMAIN=$(python3 - << 'PY'
import glob, re, os
candidates = glob.glob('/etc/nginx/conf.d/*.conf') + glob.glob('/etc/nginx/sites-enabled/*')
domains = []
for p in candidates:
    if os.path.isfile(p):
        t = open(p, errors='ignore').read()
        if 'ssl_certificate' in t:
            for m in re.finditer(r'server_name\s+([^;]+);', t):
                d = m.group(1).strip().split()[0]
                if d not in ['_', 'localhost', '""', "''"]:
                    domains.append(d)
print(sorted(domains, key=lambda x: (x.count('.'), len(x)))[0] if domains else "local.host")
PY
)

ADMIN_EMAIL="admin@${MAIN_DOMAIN}"
if [ -f /root/webui_credentials.txt ] && grep -q "Пароль" /root/webui_credentials.txt; then
    ADMIN_PASS=$(grep "Пароль" /root/webui_credentials.txt | awk '{print $NF}')
else
    ADMIN_PASS=$(openssl rand -base64 12 | tr -dc 'a-zA-Z0-9' | head -c 10)
fi
TOKEN_SECRET=$(openssl rand -hex 24)

# 3. Конфигурация авторизации
mkdir -p /opt/webui-core
cat << JSON > /opt/webui-core/config.json
{
  "admin_email": "${ADMIN_EMAIL}",
  "admin_pass": "${ADMIN_PASS}",
  "valid_token": "jwt_${TOKEN_SECRET}"
}
JSON

# 4. Создание микро-сервера WebUI-Core (Python + SQLite)
cat << 'PYSRV' > /opt/webui-core/server.py
#!/usr/bin/env python3
import http.server, socketserver, json, sqlite3, os, time, urllib.parse, subprocess, random, uuid

PORT = 3080
DB_PATH = "/opt/webui-core/storage.db"

with open("/opt/webui-core/config.json", "r", encoding="utf-8") as f:
    CFG = json.load(f)

ADMIN_EMAIL = CFG["admin_email"]
ADMIN_PASS = CFG["admin_pass"]
VALID_TOKEN = CFG["valid_token"]

USER_OBJ = {
    "id": "00000000-0000-0000-0000-000000000001",
    "email": ADMIN_EMAIL,
    "name": "Administrator",
    "role": "admin",
    "profile_image_url": "/favicon.png",
    "token": VALID_TOKEN,
    "token_type": "Bearer",
    "permissions": {
        "workspace": {"models": True, "knowledge": True, "prompts": True, "tools": True},
        "chat": {"controls": True, "file_upload": True, "delete": True, "edit": True, "temporary": True}
    }
}

CHATS_MEM = {}

def init_db():
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("CREATE TABLE IF NOT EXISTS auth_logs (id INTEGER PRIMARY KEY AUTOINCREMENT, ts TEXT, domain TEXT, ip TEXT, user TEXT, status TEXT)")
    c.execute("CREATE TABLE IF NOT EXISTS chat_messages (id INTEGER PRIMARY KEY AUTOINCREMENT, ts TEXT, sender TEXT, text TEXT)")
    c.execute("CREATE TABLE IF NOT EXISTS cluster_nodes (id INTEGER PRIMARY KEY AUTOINCREMENT, node_name TEXT, role TEXT, status TEXT, connections INT)")
    c.execute("SELECT COUNT(*) FROM cluster_nodes")
    if c.fetchone()[0] == 0:
        c.execute("INSERT INTO cluster_nodes (node_name, role, status, connections) VALUES ('db-master-01', 'Primary RW (PostgreSQL 16)', 'ONLINE', 18)")
        c.execute("INSERT INTO cluster_nodes (node_name, role, status, connections) VALUES ('db-replica-02', 'Hot Standby RO', 'ONLINE', 9)")
        c.execute("INSERT INTO cluster_nodes (node_name, role, status, connections) VALUES ('redis-cache-01', 'In-Memory Cache', 'ONLINE', 42)")
        c.execute("INSERT INTO chat_messages (ts, sender, text) VALUES (datetime('now'), 'System Bot', 'Workspace initialized. Security monitoring active.')")
    conn.commit()
    conn.close()

def get_sys_stats():
    try:
        uptime = subprocess.check_output("uptime -p", shell=True).decode().strip()
        mem = subprocess.check_output("free -m | awk '/^Mem:/{printf \"%s / %s MB\", $3, $2}'", shell=True).decode().strip()
        disk = subprocess.check_output("df -h / | awk 'NR==2{printf \"%s / %s (%s)\", $3, $2, $5}'", shell=True).decode().strip()
        load = os.getloadavg()
        return {"uptime": uptime, "ram": mem, "disk": disk, "load": f"{load[0]:.2f}, {load[1]:.2f}, {load[2]:.2f}"}
    except Exception:
        return {"uptime": "up", "ram": "N/A", "disk": "N/A", "load": "0.01"}

class ThreadingHTTPServer(socketserver.ThreadingMixIn, socketserver.TCPServer):
    allow_reuse_address = True
    daemon_threads = True

class Handler(http.server.BaseHTTPRequestHandler):
    def log_message(self, format, *args): pass

    def send_json(self, code, data, extra_headers=None):
        body = json.dumps(data).encode('utf-8')
        self.send_response(code)
        self.send_header('Content-Type', 'application/json; charset=utf-8')
        self.send_header('Content-Length', str(len(body)))
        self.send_header('Cache-Control', 'no-store')
        if extra_headers:
            for k, v in extra_headers.items():
                self.send_header(k, v)
        self.end_headers()
        self.wfile.write(body)

    def is_authed(self):
        auth = self.headers.get('Authorization', '')
        cookie = self.headers.get('Cookie', '')
        return (VALID_TOKEN in auth) or (VALID_TOKEN in cookie)

    def read_body(self):
        length = int(self.headers.get('Content-Length', 0))
        if length > 0:
            try: return json.loads(self.rfile.read(length).decode('utf-8'))
            except: return {}
        return {}

    def do_GET(self):
        p = urllib.parse.urlparse(self.path).path

        if p == '/api/config':
            return self.send_json(200, {
                "status": True, "name": "Open WebUI", "version": "0.5.20", "default_locale": "en-US",
                "oauth": {"providers": {}},
                "features": {
                    "auth": True, "auth_trusted_header": False, "enable_ldap": False, "enable_api_key": True,
                    "enable_signup": False, "enable_login_form": True, "enable_websocket": False,
                    "enable_direct_connections": False, "enable_channels": False, "enable_message_rating": True
                },
                "default_models": "deepseek-r1:32b",
                "default_prompt_suggestions": [
                    {"title": ["Server Status", "Check VPS RAM & CPU"], "content": "Show server status"},
                    {"title": ["Security Logs", "Recent login attempts"], "content": "Show recent auth logs"}
                ]
            })
        if p == '/api/version': return self.send_json(200, {"version": "0.5.20"})
        if p == '/api/changelog': return self.send_json(200, {"0.5.20": {"date": "2025-02-01", "content": "Active"}})

        if p in ['/api/v1/auths/', '/api/v1/auths', '/api/v1/users/user']:
            if self.is_authed(): return self.send_json(200, USER_OBJ)
            return self.send_json(401, {"detail": "Not authenticated"})

        if p in ['/api/models', '/ollama/api/tags', '/api/v1/models', '/api/v1/models/']:
            if not self.is_authed(): return self.send_json(401, {"detail": "Not authenticated"})
            return self.send_json(200, {"data": [
                {"id": "deepseek-r1:32b", "name": "DeepSeek-R1:32B (Local Node)", "object": "model", "created": 1730000000, "owned_by": "ollama", "info": {"meta": {"profile_image_url": "/favicon.png", "capabilities": {"vision": False}}}},
                {"id": "llama3.3:70b", "name": "Llama-3.3-70B-Instruct", "object": "model", "created": 1730000000, "owned_by": "ollama", "info": {"meta": {"profile_image_url": "/favicon.png", "capabilities": {"vision": False}}}},
                {"id": "qwen2.5-coder:32b", "name": "Qwen2.5-Coder:32B", "object": "model", "created": 1730000000, "owned_by": "ollama", "info": {"meta": {"profile_image_url": "/favicon.png", "capabilities": {"vision": False}}}}
            ]})

        if p.startswith('/api/v1/users/user/settings'):
            return self.send_json(200, {"ui": {"theme": "dark"}})

        if p.startswith('/api/v1/chats/') and len(p.split('/')) == 5:
            cid = p.split('/')[-1]
            if cid in CHATS_MEM: return self.send_json(200, CHATS_MEM[cid])

        if p == '/api/sub/dashboard':
            if not self.is_authed(): return self.send_json(401, {"error": "Unauthorized"})
            conn = sqlite3.connect(DB_PATH)
            c = conn.cursor()
            c.execute("SELECT id, ts, domain, ip, user, status FROM auth_logs ORDER BY id DESC LIMIT 15")
            logs = [{"id": r[0], "ts": r[1], "domain": r[2], "ip": r[3], "user": r[4], "status": r[5]} for r in c.fetchall()]
            c.execute("SELECT id, ts, sender, text FROM chat_messages ORDER BY id DESC LIMIT 20")
            msgs = [{"id": r[0], "ts": r[1], "sender": r[2], "text": r[3]} for r in reversed(c.fetchall())]
            c.execute("SELECT id, node_name, role, status, connections FROM cluster_nodes")
            nodes = [{"id": r[0], "name": r[1], "role": r[2], "status": r[3], "conns": r[4]} for r in c.fetchall()]
            conn.close()
            return self.send_json(200, {"stats": get_sys_stats(), "logs": logs, "messages": msgs, "nodes": nodes})

        if p.startswith('/api/'):
            return self.send_json(200 if self.is_authed() else 401, [] if self.is_authed() else {"detail": "Not authenticated"})
        self.send_json(404, {"detail": "Not found"})

    def do_POST(self):
        p = urllib.parse.urlparse(self.path).path
        data = self.read_body()
        ip = self.headers.get('X-Real-IP', self.client_address[0])
        host = self.headers.get('Host', 'unknown')

        if p in ['/api/v1/auths/signin', '/api/sub/login']:
            user = str(data.get('email') or data.get('user') or '').strip()
            pw = str(data.get('password') or '').strip()
            ok = (pw == ADMIN_PASS and len(user) > 0)
            conn = sqlite3.connect(DB_PATH)
            conn.execute("INSERT INTO auth_logs (ts, domain, ip, user, status) VALUES (datetime('now'), ?, ?, ?, ?)",
                         (host, ip, user, 'SUCCESS' if ok else 'FAILED'))
            if not ok:
                conn.execute("INSERT INTO chat_messages (ts, sender, text) VALUES (datetime('now'), 'Security Bot', ?)",
                             (f"⚠️ Failed login on {host} from IP {ip} (user: {user})",))
            conn.commit()
            conn.close()
            if ok:
                cookie = f"token={VALID_TOKEN}; Path=/; HttpOnly; SameSite=Lax"
                return self.send_json(200, USER_OBJ, extra_headers={"Set-Cookie": cookie})
            return self.send_json(400, {"detail": "The email or password provided is incorrect."})

        if p == '/api/v1/auths/signout':
            return self.send_json(200, {"status": True}, extra_headers={"Set-Cookie": "token=; Path=/; Max-Age=0"})

        if p == '/api/v1/chats/new':
            cid = str(uuid.uuid4())
            obj = {"id": cid, "title": "Server Diagnostics", "chat": data.get("chat", {}), "updated_at": int(time.time()), "created_at": int(time.time())}
            CHATS_MEM[cid] = obj
            return self.send_json(200, obj)

        if p.startswith('/api/v1/chats/') and len(p.split('/')) == 5:
            cid = p.split('/')[-1]
            obj = {"id": cid, "title": "Server Diagnostics", "chat": data.get("chat", {}), "updated_at": int(time.time()), "created_at": int(time.time())}
            CHATS_MEM[cid] = obj
            return self.send_json(200, obj)

        if p in ['/api/chat/completions', '/ollama/api/chat']:
            if not self.is_authed(): return self.send_json(401, {"detail": "Unauthorized"})
            st = get_sys_stats()
            reply = (
                f"🟢 **Node Status ({host})**\n"
                f"- **RAM Usage:** {st['ram']}\n"
                f"- **Disk Space:** {st['disk']}\n"
                f"- **CPU Load:** {st['load']}\n"
                f"- **Uptime:** {st['uptime']}\n\n"
                f"*Lightweight WebUI-Core engine is active (~15 MB RAM).*"
            )
            if data.get("stream", False):
                self.send_response(200)
                self.send_header('Content-Type', 'text/event-stream; charset=utf-8')
                self.send_header('Cache-Control', 'no-cache')
                self.end_headers()
                chunk = {"id": "chatcmpl-1", "object": "chat.completion.chunk", "created": int(time.time()), "model": data.get("model", "deepseek-r1:32b"), "choices": [{"index": 0, "delta": {"role": "assistant", "content": reply}, "finish_reason": None}]}
                done_chunk = {"id": "chatcmpl-1", "object": "chat.completion.chunk", "created": int(time.time()), "model": data.get("model", "deepseek-r1:32b"), "choices": [{"index": 0, "delta": {}, "finish_reason": "stop"}]}
                self.wfile.write(f"data: {json.dumps(chunk)}\n\ndata: {json.dumps(done_chunk)}\n\ndata: [DONE]\n\n".encode('utf-8'))
                return
            return self.send_json(200, {
                "id": "chatcmpl-1", "object": "chat.completion", "created": int(time.time()),
                "choices": [{"index": 0, "message": {"role": "assistant", "content": reply}, "finish_reason": "stop"}]
            })

        if p == '/api/sub/sql':
            if not self.is_authed(): return self.send_json(401, {"error": "Unauthorized"})
            q = str(data.get('query', 'SELECT * FROM cluster_nodes;'))
            conn = sqlite3.connect(DB_PATH)
            try:
                cur = conn.cursor()
                cur.execute(q)
                cols = [d[0] for d in cur.description] if cur.description else []
                rows = cur.fetchall()
                conn.commit()
                conn.close()
                return self.send_json(200, {"columns": cols, "rows": rows})
            except Exception as e:
                conn.close()
                return self.send_json(400, {"error": str(e)})

        if p == '/api/sub/chat':
            if not self.is_authed(): return self.send_json(401, {"error": "Unauthorized"})
            txt = str(data.get('text', '')).strip()
            if txt:
                conn = sqlite3.connect(DB_PATH)
                conn.execute("INSERT INTO chat_messages (ts, sender, text) VALUES (datetime('now'), 'Admin', ?)", (txt,))
                conn.commit()
                conn.close()
            return self.send_json(200, {"status": "ok"})

        if p == '/api/sub/db_node':
            if not self.is_authed(): return self.send_json(401, {"error": "Unauthorized"})
            act = data.get('action')
            conn = sqlite3.connect(DB_PATH)
            if act == 'toggle':
                nid = int(data.get('id', 0))
                conn.execute("UPDATE cluster_nodes SET status = CASE WHEN status='ONLINE' THEN 'MAINTENANCE' ELSE 'ONLINE' END, connections = CASE WHEN status='ONLINE' THEN 0 ELSE ? END WHERE id = ?", (random.randint(5, 35), nid))
            elif act == 'flush':
                conn.execute("UPDATE cluster_nodes SET connections = 1 WHERE status='ONLINE'")
            elif act == 'add':
                name = str(data.get('name', f'db-replica-0{random.randint(3,9)}')).strip()
                role = str(data.get('role', 'Hot Standby RO')).strip()
                conn.execute("INSERT INTO cluster_nodes (node_name, role, status, connections) VALUES (?, ?, 'ONLINE', ?)", (name, role, random.randint(4, 15)))
            elif act == 'delete':
                nid = int(data.get('id', 0))
                conn.execute("DELETE FROM cluster_nodes WHERE id = ? AND id > 1", (nid,))
            conn.commit()
            conn.close()
            return self.send_json(200, {"status": "ok"})

        return self.send_json(200, data if isinstance(data, dict) else {"status": True})

    def do_DELETE(self):
        return self.send_json(200, True)

if __name__ == '__main__':
    init_db()
    with ThreadingHTTPServer(("127.0.0.1", PORT), Handler) as httpd:
        httpd.serve_forever()
