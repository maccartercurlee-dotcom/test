if command -v ufw >/dev/null 2>&1; then
    if ufw status | grep -qw "active"; then
        SSH_PORTS=$(ss -tlnp 2>/dev/null | awk '/sshd/ {print $4}' | sed -E 's/.*:([0-9]+)$/\1/' | sort -u || true)
