write_decoy "/var/www/decoy" "AI Assistant" "Private instance · authorized access only"
for s in $SUBDOMAINS; do write_decoy "/var/www/$s" "AI Workspace" "Access to ${s}.${DOMAIN}"; done

NGINX_VER=$(nginx -v 2>&1 | sed -nE 's/.*nginx\/([0-9]+\.[0-9]+\.[0-9]+).*/\1/p'); NGINX_VER=${NGINX_VER:-0.0.0}
if dpkg --compare-versions "$NGINX_VER" ge "1.25.1"; then HTTP2_NEW=1; else HTTP2_NEW=0; fi
if dpkg --compare-versions "$NGINX_VER" ge "1.19.4"; then HAVE_MODERN=1; else HAVE_MODERN=0; fi

if [ "$HTTP2_NEW" -eq 1 ]; then H2_LINE="    http2 on;"; H2_LISTEN=""; else H2_LINE=""; H2_LISTEN=" http2"; fi

if [ "$HAVE_MODERN" -eq 1 ]; then
    CU_LINE="    ssl_conf_command Ciphersuites TLS_AES_128_GCM_SHA256:TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256;"
else
    CU_LINE=""
fi

SSL_CIPHERS='ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305'
SSL_CURVES='X25519:prime256v1:secp384r1'

if [ "$USE_VLESS" -eq 1 ]; then
    BASE_LISTEN="127.0.0.1:${NGINX_PORT}"
else
    BASE_LISTEN="443"
fi

LISTEN_DEF="    listen ${BASE_LISTEN} ssl${H2_LISTEN} default_server;"
LISTEN_MAIN="    listen ${BASE_LISTEN} ssl${H2_LISTEN};"

CONF="/etc/nginx/conf.d/decoy-master.conf"
cat > "$CONF" <<EOF
# HTTP: ACME + redirect
server {
    listen 80 default_server;
    server_name _;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://\$host\$request_uri; }
}

# HTTPS: DEFAULT (catch-all) — TLS 1.2 + 1.3
server {
${LISTEN_DEF}
${H2_LINE}
    server_name _;
    server_tokens off;
    ssl_certificate ${CERT_PATH};
    ssl_certificate_key ${KEY_PATH};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers '${SSL_CIPHERS}';
    ssl_ecdh_curve ${SSL_CURVES};
${CU_LINE}
    return 444;
}

# HTTPS: ОСНОВНОЙ ДОМЕН — TLS 1.2 + 1.3
server {
${LISTEN_MAIN}
${H2_LINE}
    server_name ${DOMAIN};
    server_tokens off;
    ssl_certificate ${CERT_PATH};
    ssl_certificate_key ${KEY_PATH};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers '${SSL_CIPHERS}';
    ssl_ecdh_curve ${SSL_CURVES};
${CU_LINE}
    location / { root /var/www/decoy; index index.html; }
EOF

if [ -n "$WEB_PATH" ] && [ "$WEB_PATH" != "/" ]; then
cat >> "$CONF" <<EOF
    location ^~ ${WEB_PATH} {
        proxy_pass http://127.0.0.1:${PANEL_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
    }
EOF
fi

if [ -n "$SUB_PATH" ] && [ "$SUB_PATH" != "/" ]; then
cat >> "$CONF" <<EOF
    location ^~ ${SUB_PATH} {
        proxy_pass http://127.0.0.1:${SUB_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_redirect off;
    }
EOF
fi

echo "}" >> "$CONF"

for s in $SUBDOMAINS; do
