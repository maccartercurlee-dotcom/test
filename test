#!/bin/bash
set -eo pipefail
GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RED='\033[0;31m'; NC='\033[0m'

if [ "${EUID:-$(id -u)}" -ne 0 ]; then
    echo -e "${RED}Запустите скрипт от имени root (sudo bash $0)${NC}"; exit 1
fi

clear
echo -e "${GREEN}=== VPN INSTALLER (3x-ui + VLESS XHTTP Reality + Hysteria2 + Nginx) ===${NC}"
echo ""

# ============================================================
#  1. РЕЖИМ ДОМЕНА
# ============================================================
echo -e "${YELLOW}Режим домена:${NC}"
echo "  1) Один домен (только example.com)"
echo "  2) Домен + субдомены (example.com + sub1.example.com ...)"
read -rp "Выбор [1]: " DOMAIN_MODE
DOMAIN_MODE=${DOMAIN_MODE:-1}
[[ "$DOMAIN_MODE" =~ ^[12]$ ]] || { echo -e "${RED}Некорректный выбор${NC}"; exit 1; }

read -rp "Основной домен (например, example.com): " RAW_DOMAIN
DOMAIN=$(echo "$RAW_DOMAIN" | tr -cd 'a-zA-Z0-9.-' | sed 's/^\.*//;s/\.*$//')
[ -z "$DOMAIN" ] && { echo -e "${RED}Домен пуст${NC}"; exit 1; }

SUBDOMAINS=""
ALL_DOMAINS="$DOMAIN"
if [ "$DOMAIN_MODE" = "2" ]; then
    read -rp "Субдомены через пробел (без .$DOMAIN, например: sub1 sub2): " RAW_SUBS
    SUBDOMAINS=$(echo "$RAW_SUBS" | tr ',' ' ' | tr -cd 'a-zA-Z0-9- ' | xargs || true)
    if [ -z "$SUBDOMAINS" ]; then
        echo -e "${YELLOW}Субдомены не указаны — работаем как с одним доменом.${NC}"
    else
        for s in $SUBDOMAINS; do ALL_DOMAINS="$ALL_DOMAINS $s.$DOMAIN"; done
    fi
fi

# ============================================================
#  2. ПРОТОКОЛЫ
# ============================================================
echo -e "${YELLOW}Протоколы (1=VLESS, 2=Hysteria2, '1 2'=оба) [1 2]:${NC}"
read -rp "Выбор: " RAW_PROTOCOLS
[ -z "$RAW_PROTOCOLS" ] && RAW_PROTOCOLS="1 2"
USE_VLESS=0; USE_HY=0
for p in $RAW_PROTOCOLS; do
    case "$p" in 1) USE_VLESS=1 ;; 2) USE_HY=1 ;; esac
done
[ "$USE_VLESS" -eq 0 ] && [ "$USE_HY" -eq 0 ] && { echo -e "${RED}Выберите хотя бы один протокол${NC}"; exit 1; }
PROTOCOLS=""
[ "$USE_VLESS" -eq 1 ] && PROTOCOLS="1"
[ "$USE_HY"    -eq 1 ] && PROTOCOLS="${PROTOCOLS:+$PROTOCOLS }2"

# ============================================================
#  3. СОХРАНИТЬ или ЧИСТО
# ============================================================
KEEP_XUI=0; KEEP_CERT=0; KEEP_NGINX=0
HAS_XUI=0;  HAS_CERT=0;  HAS_NGINX=0

[ -s /etc/x-ui/x-ui.db ] && HAS_XUI=1
[ -s "/etc/letsencrypt/live/$DOMAIN/fullchain.pem" ] && HAS_CERT=1
command -v nginx >/dev/null 2>&1 && HAS_NGINX=1

if [ "$HAS_XUI" -eq 1 ]; then
    echo ""
    echo -e "${YELLOW}Найдена существующая 3x-ui (/etc/x-ui/x-ui.db)${NC}"
    read -rp "Сохранить данные 3x-ui (клиенты, инбаунды, ключи)? [Y/n]: " ANS
    case "$ANS" in [Nn]*) KEEP_XUI=0 ;; *) KEEP_XUI=1 ;; esac
fi

if [ "$HAS_NGINX" -eq 1 ]; then
    read -rp "Сохранить пакет Nginx (конфиги всё равно будут перезаписаны)? [Y/n]: " ANS
    case "$ANS" in [Nn]*) KEEP_NGINX=0 ;; *) KEEP_NGINX=1 ;; esac
fi

if [ "$HAS_CERT" -eq 1 ]; then
    read -rp "Сохранить существующий сертификат для $DOMAIN? [Y/n]: " ANS
    case "$ANS" in [Nn]*) KEEP_CERT=0 ;; *) KEEP_CERT=1 ;; esac
fi

echo ""
echo -e "${GREEN}Режим:${NC} x-ui=$( [ $KEEP_XUI -eq 1 ] && echo СОХРАНИТЬ || echo ЧИСТО ) | nginx=$( [ $KEEP_NGINX -eq 1 ] && echo СОХРАНИТЬ || echo ПЕРЕУСТАНОВИТЬ ) | cert=$( [ $KEEP_CERT -eq 1 ] && echo СОХРАНИТЬ || echo ПЕРЕВЫПУСТИТЬ ) | домен=$( [ "$DOMAIN_MODE" = "2" ] && [ -n "$SUBDOMAINS" ] && echo "1 + субдомены" || echo "1" )"
echo ""

# ============================================================
#  4. ОСТАНОВКА / БЭКАП / ОТКЛЮЧЕНИЕ IPv6
# ============================================================
echo -e "${YELLOW}Применение системных настроек и отключение IPv6...${NC}"
cat > /etc/sysctl.d/99-disable-ipv6.conf <<SYSCTL
net.ipv6.conf.all.disable_ipv6 = 1
net.ipv6.conf.default.disable_ipv6 = 1
net.ipv6.conf.lo.disable_ipv6 = 1
SYSCTL
sysctl --system >/dev/null 2>&1 || true

systemctl stop x-ui nginx >/dev/null 2>&1 || true
export DEBIAN_FRONTEND=noninteractive

if [ "$KEEP_XUI" -eq 0 ]; then
    mkdir -p /root/xui_backups
    [ -f /etc/x-ui/x-ui.db ] && cp /etc/x-ui/x-ui.db "/root/xui_backups/x-ui.db.backup-$(date +%F-%H-%M)" || true
    rm -rf /etc/x-ui /usr/local/x-ui /usr/bin/x-ui /etc/systemd/system/x-ui.service
fi

if [ "$KEEP_NGINX" -eq 0 ]; then
    apt-get purge -y nginx nginx-common nginx-core nginx-full >/dev/null 2>&1 || true
    rm -rf /etc/nginx
fi

rm -rf /var/www/decoy /var/www/certbot
for s in $SUBDOMAINS; do rm -rf "/var/www/$s"; done

# ============================================================
#  5. ЗАВИСИМОСТИ
# ============================================================
echo -e "${YELLOW}[1/6] Установка зависимостей...${NC}"
apt-get update
apt-get install -y nginx certbot curl wget sqlite3 openssl python3
timedatectl set-ntp true >/dev/null 2>&1 || true

# ============================================================
#  6. 3x-ui: СОХРАНИТЬ или УСТАНОВИТЬ
# ============================================================
PANEL_USER="admin"
PANEL_PASS=""
IS_UPDATE=0

if [ "$KEEP_XUI" -eq 1 ]; then
    IS_UPDATE=1
    if [ ! -f /etc/systemd/system/x-ui.service ]; then
        echo -e "${YELLOW}Юнит x-ui.service отсутствует — переустановка (БД сохранена).${NC}"
        wget -qO /tmp/xui-install.sh https://raw.githubusercontent.com/mhsanaei/3x-ui/master/install.sh
        printf "1\nn\n4\ny\n" | bash /tmp/xui-install.sh
        rm -f /tmp/xui-install.sh
    fi
    echo -e "${GREEN}Используется существующая 3x-ui.${NC}"
else
    PANEL_PASS=$(openssl rand -hex 8)
    echo -e "${YELLOW}Установка 3x-ui (чистая)...${NC}"
    wget -qO /tmp/xui-install.sh https://raw.githubusercontent.com/mhsanaei/3x-ui/master/install.sh
    printf "1\nn\n4\ny\n" | bash /tmp/xui-install.sh
    rm -f /tmp/xui-install.sh
    systemctl start x-ui || true
    for _ in $(seq 1 15); do [ -s /etc/x-ui/x-ui.db ] && break; sleep 1; done
    sleep 2
    systemctl stop x-ui || true
    [ -s /etc/x-ui/x-ui.db ] || { echo -e "${RED}ОШИБКА: /etc/x-ui/x-ui.db не создана.${NC}"; exit 1; }
fi

# ============================================================
#  7. DEPLOY HOOK
# ============================================================
echo -e "${YELLOW}[2/6] Deploy-hook для авто-renewal...${NC}"
mkdir -p /etc/letsencrypt/renewal-hooks/deploy/
cat > /etc/letsencrypt/renewal-hooks/deploy/restart-xui-nginx.sh <<'HOOK'
#!/bin/bash
systemctl reload nginx || true
systemctl restart x-ui || true
HOOK
chmod +x /etc/letsencrypt/renewal-hooks/deploy/restart-xui-nginx.sh

# ============================================================
#  8. SSL СЕРТИФИКАТ
# ============================================================
echo -e "${YELLOW}[3/6] SSL-сертификат...${NC}"
mkdir -p /var/www/certbot
CERT_PATH="/etc/letsencrypt/live/$DOMAIN/fullchain.pem"
KEY_PATH="/etc/letsencrypt/live/$DOMAIN/privkey.pem"
SELF_SIGNED=0

if [ "$KEEP_CERT" -eq 1 ] && [ -f "$CERT_PATH" ]; then
    echo -e "${GREEN}Используется существующий сертификат: $CERT_PATH${NC}"
    EXISTING_SANS=$(openssl x509 -in "$CERT_PATH" -noout -ext subjectAltName 2>/dev/null | grep -oE '[A-Za-z0-9.-]+\.[A-Za-z]{2,}' | sort -u | tr '\n' ' ' || true)
    NEED_EXPAND=0
    for d in $ALL_DOMAINS; do
        echo " $EXISTING_SANS " | grep -q " $d " || NEED_EXPAND=1
    done
    if [ "$NEED_EXPAND" -eq 1 ]; then
        echo -e "${YELLOW}Сертификат не покрывает все домены — расширяем...${NC}"
        KEEP_CERT=0
    fi
fi

rm -f /etc/nginx/sites-enabled/*
rm -f /etc/nginx/sites-available/default
rm -f /etc/nginx/conf.d/*.conf
mkdir -p /etc/nginx/sites-enabled /etc/nginx/sites-available /etc/nginx/conf.d

if [ "$KEEP_CERT" -eq 0 ]; then
    cat > /etc/nginx/conf.d/acme-temp.conf <<NGINX
server {
    listen 80 default_server;
    server_name _;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://\$host\$request_uri; }
}
NGINX
    systemctl restart nginx || true
    CERTBOT_ARGS=""
    for d in $ALL_DOMAINS; do CERTBOT_ARGS="$CERTBOT_ARGS -d $d"; done
    if certbot certonly --webroot -w /var/www/certbot \
        --cert-name "$DOMAIN" $CERTBOT_ARGS \
        --keep-until-expiring --expand --non-interactive --agree-tos \
        -m "admin@$DOMAIN"; then
        echo -e "${GREEN}Сертификат получен/расширен.${NC}"
    else
        SELF_SIGNED=1
        echo -e "${RED}Certbot не смог выпустить сертификат. Генерируем self-signed.${NC}"
        mkdir -p /etc/ssl/self-signed
        openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
            -keyout /etc/ssl/self-signed/privkey.pem \
            -out    /etc/ssl/self-signed/fullchain.pem \
            -subj "/CN=$DOMAIN" >/dev/null 2>&1
        CERT_PATH="/etc/ssl/self-signed/fullchain.pem"
        KEY_PATH="/etc/ssl/self-signed/privkey.pem"
    fi
fi
rm -f /etc/nginx/conf.d/acme-temp.conf

# ============================================================
#  9. БАЗА 3x-ui
# ============================================================
echo -e "${YELLOW}[4/6] Настройка базы 3x-ui...${NC}"
PANEL_PORT=$(sqlite3 /etc/x-ui/x-ui.db "SELECT value FROM settings WHERE key='webPort' LIMIT 1;" 2>/dev/null || true)
SUB_PORT=$(  sqlite3 /etc/x-ui/x-ui.db "SELECT value FROM settings WHERE key='subPort' LIMIT 1;" 2>/dev/null || true)
WEB_PATH=$(  sqlite3 /etc/x-ui/x-ui.db "SELECT value FROM settings WHERE key='webBasePath' LIMIT 1;" 2>/dev/null || true)
SUB_PATH=$(  sqlite3 /etc/x-ui/x-ui.db "SELECT value FROM settings WHERE key='subPath' LIMIT 1;" 2>/dev/null || true)

PANEL_PORT=${PANEL_PORT:-2053}
SUB_PORT=${SUB_PORT:-2096}
WEB_PATH=$(echo "${WEB_PATH:-/$(openssl rand -hex 16)/}" | sed 's|^/*|/|;s|/*$|/|')
SUB_PATH=$(echo "${SUB_PATH:-/$(openssl rand -hex 16)/}" | sed 's|^/*|/|;s|/*$|/|')

NGINX_PORT=40000
if [ "$USE_VLESS" -eq 1 ] && [ "$IS_UPDATE" -eq 1 ]; then
    EXISTING_TARGET=$(sqlite3 /etc/x-ui/x-ui.db \
        "SELECT stream_settings FROM inbounds WHERE protocol='vless' AND tag='in-443-tcp' LIMIT 1;" 2>/dev/null || true)
    if [ -n "$EXISTING_TARGET" ]; then
        EXTRACTED=$(echo "$EXISTING_TARGET" | grep -oE '"target"[[:space:]]*:[[:space:]]*"[^"]+"' | grep -oE ':[0-9]+"$' | tr -d ':"' || true)
        [ -n "$EXTRACTED" ] && NGINX_PORT="$EXTRACTED"
    fi
fi

export DB_DOMAIN="$DOMAIN" DB_ALL_DOMAINS="$ALL_DOMAINS" DB_SUBS="$SUBDOMAINS" \
       DB_PANEL_PORT="$PANEL_PORT" DB_SUB_PORT="$SUB_PORT" \
       DB_WEB_PATH="$WEB_PATH" DB_SUB_PATH="$SUB_PATH" \
       DB_CERT_PATH="$CERT_PATH" DB_KEY_PATH="$KEY_PATH" \
       DB_PROTOCOLS="$PROTOCOLS" DB_NGINX_PORT="$NGINX_PORT" DB_IS_UPDATE="$IS_UPDATE"

python3 <<'PYEOF'
import glob, json, os, secrets, sqlite3, subprocess, sys, time, uuid

DOMAIN      = os.environ['DB_DOMAIN']
ALL_DOMAINS = os.environ['DB_ALL_DOMAINS'].split()
SUBS        = os.environ['DB_SUBS'].split()
PANEL_PORT  = os.environ['DB_PANEL_PORT']
SUB_PORT    = os.environ['DB_SUB_PORT']
WEB_PATH    = os.environ['DB_WEB_PATH']
SUB_PATH    = os.environ['DB_SUB_PATH']
CERT_PATH   = os.environ['DB_CERT_PATH']
KEY_PATH    = os.environ['DB_KEY_PATH']
NGINX_PORT  = os.environ['DB_NGINX_PORT']
PROTOCOLS   = os.environ['DB_PROTOCOLS'].split()
IS_UPDATE   = int(os.environ['DB_IS_UPDATE'])

USE_VLESS   = '1' in PROTOCOLS
USE_HY      = '2' in PROTOCOLS

conn = sqlite3.connect('/etc/x-ui/x-ui.db'); c = conn.cursor()
now = int(time.time() * 1000)

def upsert_setting(cur, key, val):
    cur.execute("UPDATE settings SET value=? WHERE key=?", (val, key))
    if cur.rowcount == 0:
        cur.execute("INSERT INTO settings (key, value) VALUES (?, ?)", (key, val))

c.execute("SELECT name FROM sqlite_master WHERE type='table'")
tables = {r[0] for r in c.fetchall()}

XHTTP = {"path":"/api/v1/ws","host":"","mode":"stream-one","xPaddingBytes":"10-100",
    "xPaddingObfsMode":True,"xPaddingKey":"","xPaddingHeader":"","xPaddingPlacement":"cookie",
    "xPaddingMethod":"repeat-x","sessionIDPlacement":"","sessionIDKey":"","sessionIDTable":"Base62",
    "sessionIDLength":"8-16","seqPlacement":"","seqKey":"","uplinkDataPlacement":"",
    "uplinkDataKey":"","scMaxEachPostBytes":"","noSSEHeader":False,"scMaxBufferedPosts":30,
    "scStreamUpServerSecs":"20-80","serverMaxHeaderBytes":0,"uplinkHTTPMethod":"POST",
    "headers":{"User-Agent":"Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:128.0) Gecko/20100101 Firefox/128.0",
               "Accept-Language":"en-US,en;q=0.5","Accept":"text/event-stream"},
    "scMinPostsIntervalMs":"","uplinkChunkSize":0,"noGRPCHeader":False,
    "xmux":{"maxConcurrency":"16-32","maxConnections":0,"cMaxReuseTimes":0,
            "hMaxRequestTimes":"600-900","hMaxReusableSecs":"1800-3000","hKeepAlivePeriod":0},
    "enableXmux":True}

SOCKOPT = {"tcpFastOpen":True,"tcpcongestion":"bbr","acceptProxyProtocol":False,"mark":0,
    "tproxy":"off","tcpMptcp":False,"penetrate":False,"domainStrategy":"AsIs",
    "tcpMaxSeg":0,"dialerProxy":"","tcpKeepAliveInterval":0,"tcpKeepAliveIdle":0,
    "tcpUserTimeout":0,"V6Only":False,"tcpWindowClamp":0,"interface":"",
    "trustedXForwardedFor":[],"addressPortStrategy":"none","customSockopt":[]}

def gen_xray_keys():
    bins = sorted(p for p in glob.glob('/usr/local/x-ui/bin/xray*')
                  if os.path.isfile(p) and os.access(p, os.X_OK))
    if not bins:
        print("xray not found", file=sys.stderr); sys.exit(1)
    k = subprocess.check_output([bins[0],"x25519"]).decode()
    pk  = [l.split()[-1] for l in k.splitlines() if 'Private' in l][0]
    pub = [l.split()[-1] for l in k.splitlines() if 'Password' in l or 'Public' in l][0]
    return pk, pub

def get_vless_stream(pk, pub):
    shorts = [secrets.token_hex(n)[:n] for n in (8,2,10,6,14,4,12,16)]
    spider = "/" + secrets.token_urlsafe(10)[:15]
    return {"network":"xhttp","xhttpSettings":XHTTP,"sockopt":SOCKOPT,
        "security":"reality",
        "realitySettings":{"show":False,"xver":0,"target":f"127.0.0.1:{NGINX_PORT}",
            "serverNames":ALL_DOMAINS,"privateKey":pk,
            "minClientVer":"","maxClientVer":"","maxTimediff":0,
            "shortIds":shorts,"mldsa65Seed":"",
            "settings":{"publicKey":pub,"fingerprint":"firefox",
                        "serverName":DOMAIN,"spiderX":spider,"mldsa65Verify":""}}}

def get_hy_stream():
    return {"network":"hysteria",
        "hysteriaSettings":{"version":2,"udpIdleTimeout":60,
            "masquerade":{"type":"proxy","url":f"https://127.0.0.1:{NGINX_PORT}/","rewriteHost":True}},
        "security":"tls",
        "tlsSettings":{"serverName":DOMAIN,"minVersion":"1.3","maxVersion":"1.3",
            "certificates":[{"certificateFile":CERT_PATH,"keyFile":KEY_PATH,"useFile":True}],
            "alpn":["h3"],
            "settings":{"fingerprint":"firefox","echConfigList":"","echServerKeys":""}},
        "finalmask":{"quicParams":{"congestion":"bbr","debug":False,"maxIdleTimeout":30,
            "keepAlivePeriod":10,"disablePathMTUDiscovery":False,"maxIncomingStreams":2048,
            "initStreamReceiveWindow":16777216,"maxStreamReceiveWindow":16777216,
            "initConnectionReceiveWindow":33554432,"maxConnectionReceiveWindow":33554432,
            "bbrProfile":"aggressive"}}}

if IS_UPDATE == 0:
    for t in ("client_inbounds","client_traffics","clients","inbounds"):
        if t in tables: c.execute(f"DELETE FROM {t}")
    tmpl = {"log":{"loglevel":"warning"},
        "api":{"services":["HandlerService","LoggerService","StatsService","RoutingService"],"tag":"api"},
        "stats":{},
        "policy":{"levels":{"0":{"statsUserUplink":True,"statsUserDownlink":True,"statsUserOnline":True}},
                  "system":{"statsInboundUplink":True,"statsInboundDownlink":True,
                            "statsOutboundUplink":True,"statsOutboundDownlink":True}},
        "inbounds":[{"listen":"127.0.0.1","port":62789,"protocol":"dokodemo-door",
                     "settings":{"address":"127.0.0.1"},"tag":"api","sniffing":{"enabled":False}}],
        "outbounds":[{"protocol":"freedom","tag":"direct"},{"protocol":"blackhole","tag":"blocked"}],
        "routing":{"domainStrategy":"AsIs",
                   "rules":[{"type":"field","inboundTag":["api"],"outboundTag":"api"},
                            {"type":"field","ip":["geoip:private"],"outboundTag":"blocked"}]}}
    for k,v in [('webPort',PANEL_PORT),('webBasePath',WEB_PATH),('webListen','127.0.0.1'),
                ('webCertFile',''),('webKeyFile',''),
                ('subPort',SUB_PORT),('subPath',SUB_PATH),('subListen','127.0.0.1'),
                ('subEnable','true'),('subDomain',DOMAIN),
                ('subURI',f"https://{DOMAIN}{SUB_PATH}"),
                ('subShowInfo','false'),('subJsonEnable','false'),
                ('subCertFile',''),('subKeyFile',''),
                ('xrayTemplateConfig',json.dumps(tmpl))]:
        upsert_setting(c, k, v)
    seed = [{"name":n,"uuid":str(uuid.uuid4()),"sub":secrets.token_hex(8)}
            for n in ("zfold","passwall","work","TV","note10")]
    vless_id = None; hy_id = None
    if USE_VLESS:
        pk, pub = gen_xray_keys()
        vc = [{"id":x["uuid"],"email":x["name"],"subId":x["sub"],"flow":"","security":"auto",
               "limitIp":0,"totalGB":0,"expiryTime":0,"enable":True,"tgId":0,
               "reset":0,"resetDay":0,"resetWeekday":0,"resetMax":0,
               "comment":"","created_at":now,"updated_at":now} for x in seed]
        c.execute("INSERT INTO inbounds (user_id,up,down,total,expiry_time,remark,port,protocol,settings,stream_settings,tag,sniffing,enable) "
                  "VALUES (1,0,0,0,0,'VLESS-REALITY',443,'vless',?,?,'in-443-tcp',?,1)",
                  (json.dumps({"clients":vc,"decryption":"none","encryption":"none"}),
                   json.dumps(get_vless_stream(pk, pub)),
                   '{"enabled":true,"destOverride":["http","tls","quic","fakedns"]}'))
        vless_id = c.lastrowid
    if USE_HY:
        hc = [{"id":x["uuid"],"email":x["name"],"subId":x["sub"],"auth":x["uuid"],"password":x["uuid"],
               "flow":"","security":"auto","limitIp":0,"totalGB":0,"expiryTime":0,
               "enable":True,"tgId":0,"reset":0,"resetDay":0,"resetWeekday":0,"resetMax":0,
               "comment":"","created_at":now,"updated_at":now} for x in seed]
        c.execute("INSERT INTO inbounds (user_id,up,down,total,expiry_time,remark,port,protocol,settings,stream_settings,tag,sniffing,enable) "
                  "VALUES (1,0,0,0,0,'Hysteria2',443,'hysteria',?,?,'in-443-udp',?,1)",
                  (json.dumps({"clients":hc,"version":2}),
                   json.dumps(get_hy_stream()),
                   '{"enabled":true,"destOverride":["http","tls"]}'))
        hy_id = c.lastrowid
    first_inb = vless_id if vless_id else hy_id
    for x in seed:
        c.execute("INSERT INTO clients (email,sub_id,uuid,password,auth,flow,security,limit_ip,total_gb,expiry_time,enable,tg_id,comment,reset,group_name,created_at,updated_at) "
                  "VALUES (?,?,?,?,?,'','auto',0,0,0,1,0,'',0,'',?,?)",
                  (x["name"],x["sub"],x["uuid"],x["uuid"],x["uuid"],now,now))
        cid = c.lastrowid
        for iid in (vless_id, hy_id):
            if iid is None: continue
            c.execute("INSERT INTO client_inbounds (client_id,inbound_id,flow_override,created_at) VALUES (?,?,'',?)",
                      (cid,iid,now))
        if first_inb is not None:
            c.execute("INSERT INTO client_traffics (inbound_id,enable,email,up,down,expiry_time,total,reset,last_online) "
                      "VALUES (?,1,?,0,0,0,0,0,0)", (first_inb,x["name"]))
else:
    for k,v in [('subDomain',DOMAIN),('subURI',f"https://{DOMAIN}{SUB_PATH}"),
                ('subEnable','true'),('subListen','127.0.0.1'),('subPort',SUB_PORT),
                ('subPath',SUB_PATH),('webBasePath',WEB_PATH),('webListen','127.0.0.1'),
                ('webPort',PANEL_PORT),('subShowInfo','false'),('subJsonEnable','false'),
                ('subCertFile',''),('subKeyFile',''),('webCertFile',''),('webKeyFile','')]:
        upsert_setting(c, k, v)
    
    # 1. Обновление или создание VLESS
    if USE_VLESS:
        c.execute("SELECT id, stream_settings FROM inbounds WHERE protocol='vless'")
        rows = c.fetchall()
        if rows:
            for iid, stream_str in rows:
                if not stream_str: continue
                try: stream = json.loads(stream_str)
                except Exception: continue
                rs = stream.setdefault('realitySettings', {})
                rss = rs.setdefault('settings', {})
                if not rss.get('serverName'): rss['serverName'] = DOMAIN
                rs['serverNames'] = ALL_DOMAINS
                rs['target'] = f"127.0.0.1:{NGINX_PORT}"
                c.execute("UPDATE inbounds SET stream_settings=? WHERE id=?", (json.dumps(stream), iid))
        else:
            # Создаем новый VLESS инбаунд при обновлении
            c.execute("SELECT email, sub_id, uuid FROM clients")
            existing = c.fetchall()
            pk, pub = gen_xray_keys()
            vc = [{"id":u,"email":e,"subId":s,"flow":"","security":"auto",
                   "limitIp":0,"totalGB":0,"expiryTime":0,"enable":True,"tgId":0,
                   "reset":0,"resetDay":0,"resetWeekday":0,"resetMax":0,
                   "comment":"","created_at":now,"updated_at":now} for (e,s,u) in existing]
            c.execute("INSERT INTO inbounds (user_id,up,down,total,expiry_time,remark,port,protocol,settings,stream_settings,tag,sniffing,enable) "
                      "VALUES (1,0,0,0,0,'VLESS-REALITY',443,'vless',?,?,'in-443-tcp',?,1)",
                      (json.dumps({"clients":vc,"decryption":"none","encryption":"none"}),
                       json.dumps(get_vless_stream(pk, pub)),
                       '{"enabled":true,"destOverride":["http","tls","quic","fakedns"]}'))
            vless_id = c.lastrowid
            for (e,_,_) in existing:
                c.execute("INSERT INTO client_inbounds (client_id,inbound_id,flow_override,created_at) "
                          "SELECT id,?,'',? FROM clients WHERE email=?", (vless_id, now, e))

    # 2. Обновление или создание Hysteria2
    if USE_HY:
        c.execute("SELECT id, stream_settings FROM inbounds WHERE protocol='hysteria'")
        rows = c.fetchall()
        if rows:
            for iid, stream_str in rows:
                if not stream_str: continue
                try: stream = json.loads(stream_str)
                except Exception: continue
                tls = stream.setdefault('tlsSettings', {})
                tls['serverName'] = DOMAIN
                certs = tls.get('certificates') or []
                if certs:
                    certs[0]['certificateFile'] = CERT_PATH
                    certs[0]['keyFile'] = KEY_PATH
                    tls['certificates'] = certs
                c.execute("UPDATE inbounds SET stream_settings=? WHERE id=?", (json.dumps(stream), iid))
        else:
            # Создаем новый Hysteria2 инбаунд при обновлении
            c.execute("SELECT email, sub_id, uuid FROM clients")
            existing = c.fetchall()
            if existing:
                hc = [{"id":u,"email":e,"subId":s,"auth":u,"password":u,"flow":"","security":"auto",
                       "limitIp":0,"totalGB":0,"expiryTime":0,"enable":True,"tgId":0,
                       "reset":0,"resetDay":0,"resetWeekday":0,"resetMax":0,
                       "comment":"","created_at":now,"updated_at":now} for (e,s,u) in existing]
                c.execute("INSERT INTO inbounds (user_id,up,down,total,expiry_time,remark,port,protocol,settings,stream_settings,tag,sniffing,enable) "
                          "VALUES (1,0,0,0,0,'Hysteria2',443,'hysteria',?,?,'in-443-udp',?,1)",
                          (json.dumps({"clients":hc,"version":2}), json.dumps(get_hy_stream()),
                           '{"enabled":true,"destOverride":["http","tls"]}'))
                hy_id = c.lastrowid
                for (e,_,_) in existing:
                    c.execute("INSERT INTO client_inbounds (client_id,inbound_id,flow_override,created_at) "
                              "SELECT id,?,'',? FROM clients WHERE email=?", (hy_id, now, e))

conn.commit(); conn.close()
print("DB OK")
