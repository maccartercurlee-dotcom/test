${LISTEN_MAIN}
${H2_LINE}
    server_name ${s}.${DOMAIN};
    server_tokens off;
    ssl_certificate ${CERT_PATH};
    ssl_certificate_key ${KEY_PATH};
    ssl_protocols TLSv1.3;
    ssl_ecdh_curve ${SSL_CURVES};
${CU_LINE}
